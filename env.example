# Bunny CDN Configuration
# Add these to your .env.local file

# Bunny CDN API Key (from your Bunny CDN dashboard)
BUNNY_CDN_API_KEY=your_bunny_cdn_api_key_here

# Bunny CDN Storage Zone name (the zone you created)
BUNNY_CDN_STORAGE_ZONE=your_storage_zone_name

# Bunny CDN URL (optional, will be auto-generated if not provided)
BUNNY_CDN_URL=https://your-storage-zone.b-cdn.net

# Example:
# BUNNY_CDN_API_KEY=12345678-1234-1234-1234-123456789012
# BUNNY_CDN_STORAGE_ZONE=shriarya-lms-files
# BUNNY_CDN_URL=https://shriarya-lms-files.b-cdn.net
