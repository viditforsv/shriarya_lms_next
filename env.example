# Shrividhya Classes Environment Variables
# Copy this file to .env.local and fill in your actual values

# ============================================================================
# ENVIRONMENT CONFIGURATION
# ============================================================================
# Set to 'dev' or 'prod' to explicitly control which environment to use
# If not set, defaults to 'dev' (or 'prod' if NODE_ENV=production)
NEXT_PUBLIC_ENVIRONMENT=dev

# ============================================================================
# SUPABASE CONFIGURATION
# ============================================================================
# The system supports environment-specific credentials with fallback to generic ones
# Priority: _DEV/_PROD suffixed vars > generic vars

# Development Supabase (used when NEXT_PUBLIC_ENVIRONMENT=dev)
NEXT_PUBLIC_SUPABASE_URL_DEV=https://your-dev-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY_DEV=your_dev_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY_DEV=your_dev_supabase_service_role_key_here

# Production Supabase (used when NEXT_PUBLIC_ENVIRONMENT=prod)
NEXT_PUBLIC_SUPABASE_URL_PROD=https://your-prod-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY_PROD=your_prod_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY_PROD=your_prod_supabase_service_role_key_here

# Fallback Supabase Configuration (used if environment-specific vars are not set)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ============================================================================
# GOOGLE OAUTH (Optional - if using Google sign-in)
# ============================================================================
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ============================================================================
# PAYMENT INTEGRATION (Razorpay)
# ============================================================================
# Development/Test Keys
RAZORPAY_KEY_ID_TEST=rzp_test_your_test_key_id_here
RAZORPAY_KEY_SECRET_TEST=your_test_razorpay_key_secret_here

# Production Keys
RAZORPAY_KEY_ID=rzp_live_your_live_key_id_here
RAZORPAY_KEY_SECRET=your_live_razorpay_key_secret_here
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_your_live_key_id_here

# ============================================================================
# APP CONFIGURATION
# ============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development
