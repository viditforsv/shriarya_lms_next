# PRODUCTION ENVIRONMENT CONFIGURATION
# This file is used when working on the MAIN branch or deploying to production
# Copy this to .env.local when working on main branch or deploying

# ============================================================================
# ENVIRONMENT CONFIGURATION
# ============================================================================
NEXT_PUBLIC_ENVIRONMENT=prod

# ============================================================================
# PRODUCTION SUPABASE CONFIGURATION
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL_PROD=https://your-prod-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY_PROD=your_prod_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY_PROD=your_prod_supabase_service_role_key_here

# ============================================================================
# GOOGLE OAUTH (Optional - if using Google sign-in)
# ============================================================================
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ============================================================================
# RAZORPAY PRODUCTION KEYS
# ============================================================================
RAZORPAY_KEY_ID=rzp_live_your_live_key_id_here
RAZORPAY_KEY_SECRET=your_live_razorpay_key_secret_here
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_your_live_key_id_here

# ============================================================================
# APP CONFIGURATION
# ============================================================================
NEXT_PUBLIC_APP_URL=https://courses.shrividhya.in
NEXT_PUBLIC_SITE_URL=https://courses.shrividhya.in
NODE_ENV=production

